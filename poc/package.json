{
  "name": "brightminds",
  "version": "1.0.0",
  "private": true,
  "description": "BrightMinds — kids learning PWA",
  "scripts": {
    "generate:audio": "node tools/generate-audio.js --voices=salma,aria",
    "generate:audio:all": "node tools/generate-audio.js",
